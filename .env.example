# ---------------------------------------------------------------------------
# TableTap — environment configuration
# Copy to .env at the repository root:  cp .env.example .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Host port 5440 avoids colliding with a local PostgreSQL.
DATABASE_URL=postgresql://tabletap:tabletap@localhost:5440/tabletap?schema=public

# --- Redis (optional for this build; used for health and future queues) -----
REDIS_URL=redis://localhost:6390

# --- Object storage ---------------------------------------------------------
# No upload feature is implemented yet; menu images are URLs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=tabletap
S3_ACCESS_KEY=tabletap
S3_SECRET_KEY=tabletap123

# --- Mail (Mailpit) ---------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1125
MAIL_FROM="TableTap <no-reply@tabletap.local>"

# --- URLs -------------------------------------------------------------------
API_PORT=4100
API_URL=http://localhost:4100
WEB_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4100

# --- Secrets ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-0000000000000000
JWT_CUSTOMER_SECRET=dev-only-customer-secret-change-me-please-000000000000
# Optional; falls back to JWT_ACCESS_SECRET for QR token ciphertext.
QR_ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:3100

# --- Sessions ---------------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CUSTOMER_SESSION_TTL_HOURS=6

# --- Rate limiting ----------------------------------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# --- Business defaults ------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Bangkok
DEFAULT_CURRENCY=THB
DEFAULT_VAT_RATE=7

# "development" grants every feature to the demo tenant so the whole product
# can be exercised locally. "enforced" applies real plan limits.
SUBSCRIPTION_MODE=development

# --- Demo seed --------------------------------------------------------------
SEED_DEMO_DATA=true
DEMO_PASSWORD=TableTap!2026
# Optional. Leave unset to seed a non-payable placeholder (0000000000000).
# Set both to your own PromptPay target if you want the demo QR to be payable.
# DEMO_PROMPT_PAY_ID=
# DEMO_PROMPT_PAY_NAME=

# Payment provider webhook: HMAC-SHA256 over the raw body.
# In development the API also accepts the demo default and the POS can simulate a
# provider settlement. Set a real secret before production.
PAYMENT_WEBHOOK_SECRET=dev-only-demo-webhook-secret
# Show "Simulate provider paid" in the POS (development only by default anyway).
PAYMENT_DEMO_PROVIDER=true

